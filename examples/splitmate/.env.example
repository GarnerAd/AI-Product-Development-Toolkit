# Environment variables. Copy to .env.local only if you need to change a default.
# Nothing here is a secret: hosted credentials never sit on a development machine.

# Where the local database lives. Keep it inside the project, or use :memory:.
SPLITMATE_DB=.data/splitmate.db

# Public address used for metadata. Localhost by default.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Hosted setup (not wired in yet; add these in the hosting and CI settings only) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
